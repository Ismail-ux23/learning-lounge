PLATFORM_NAME=Learning Lounge by ismail
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///lounge.db
PUBLIC_URL=http://localhost:5066
PRODUCTION=0
REDIS_URL=redis://localhost:6379/0
AI_PROVIDER=gemini
# Change this if your Gemini account uses a different model.
AI_MODEL=gemini-3.1-flash-lite
AI_ENDPOINT=http://localhost:11434
AI_TIMEOUT=45
GEMINI_API_KEY=
# Private operator-controlled Judge0 service, never a URL entered by a learner.
JUDGE0_URL=
JUDGE0_TOKEN=
# Development mail: Mailpit on localhost:1025; view inbox on localhost:8025.
MAIL_HOST=
MAIL_PORT=1025
MAIL_FROM=learning@localhost
