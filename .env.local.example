# Local development only. Copy this file to .env.
PLATFORM_NAME=Learning Lounge
# Blank creates a private, persistent key in instance/session.key.
# Set a random SECRET_KEY explicitly before deployment.
SECRET_KEY=
DATABASE_URL=sqlite:///lounge.db
PUBLIC_URL=http://localhost:5066
PRODUCTION=0
# Process-local rate limits; no Redis server needed for the basic demo.
REDIS_URL=memory://
# Leave AI unconfigured until you add a provider and model.
AI_PROVIDER=ollama
AI_MODEL=
AI_ENDPOINT=http://localhost:11434
AI_TIMEOUT=45
GEMINI_API_KEY=
JUDGE0_URL=
JUDGE0_TOKEN=
MAIL_HOST=
MAIL_PORT=1025
MAIL_FROM=learning@localhost
